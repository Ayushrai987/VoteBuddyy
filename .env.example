# Environment Variables for VoteBuddy
# Copy this file to .env.local and fill in your values

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Maps (client-side)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Anthropic Claude API (server-side ONLY)
ANTHROPIC_API_KEY=

# Upstash Redis (server-side ONLY)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Translate API (server-side ONLY)
GOOGLE_TRANSLATE_API_KEY=

# Admin email whitelist (comma-separated)
ADMIN_EMAILS=admin@votebuddy.in
